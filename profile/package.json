{
  "name": "omni-desktop-profile",
  "private": true,
  "description": "The dsh profile the Omni desktop app starts: dsh's own base and web app, its plugin market, Omni's plugins (the team, channels, canvases and the welcome), and the add-ons that connect AI subscriptions: dsh-subscriptions (the plans DSH doesn't sign in to itself) and Oh My Claude (Claude through the person's own Claude Code), each from Omni's reviewed fork at a pinned commit.",
  "omni": {
    "addonVersions": {
      "@goodandready/dsh-subscriptions": "0.7.21-omni.1",
      "dsh-oh-my-claude": "1.5.6-omni.1"
    }
  },
  "dependencies": {
    "@automagik/omni-dsh": "*",
    "@automagik/omni-channels-dsh": "*",
    "@automagik/omni-canvas-dsh": "*",
    "@automagik/omni-ai-dsh": "*",
    "@goodandready/dsh-subscriptions": "github:automagik-genie/dsh-subscriptions#2eff034ede95c9d06ecee290517101e6419c7fee",
    "dsh-oh-my-claude": "github:automagik-genie/dsh-oh-my-claude#ccca7fe46871c0e188d2272d2aa92f2d7d4502c4"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@deepseek-ai/dsh-experimental-plugin-market-bundle",
        "@automagik/omni-dsh",
        "@automagik/omni-channels-dsh",
        "@automagik/omni-canvas-dsh",
        "@automagik/omni-ai-dsh",
        "@goodandready/dsh-subscriptions",
        "dsh-oh-my-claude"
      ]
    }
  }
}
